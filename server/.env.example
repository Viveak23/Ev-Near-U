# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/ev_near_u

# JWT Authentication Secret & Expiration
JWT_SECRET=super_secret_ev_near_u_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Razorpay / Payment Gateway Config (Sandbox credentials for dev)
RAZORPAY_KEY_ID=rzp_test_sample_key_evnearu
RAZORPAY_KEY_SECRET=sample_secret_key_evnearu

# Platform Fee Percentage & Commission Rate
PLATFORM_FEE_PERCENT=5
HOST_COMMISSION_PERCENT=10
TAX_GST_PERCENT=18
