# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas in production)
MONGODB_URI=mongodb://127.0.0.1:27017/ev_near_u

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK Configuration (Production Auth)
# Option A: Full JSON Service Account string (Recommended for Render)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"evnearu-prod","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@evnearu-prod.iam.gserviceaccount.com"}

# Option B: Individual Firebase credentials
FIREBASE_PROJECT_ID=ev-near-u
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@evnearu-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option C: Path to serviceAccountKey.json file (Local development)
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Razorpay / Payment Gateway Config (Sandbox credentials for dev)
RAZORPAY_KEY_ID=rzp_test_sample_key_evnearu
RAZORPAY_KEY_SECRET=sample_secret_key_evnearu

# Platform Fee Percentage & Commission Rate
PLATFORM_FEE_PERCENT=5
HOST_COMMISSION_PERCENT=10
TAX_GST_PERCENT=18
